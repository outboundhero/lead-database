# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/geo/raw/
data/geo/places_slim.tsv

# invoice files for scripts/costing-import.mjs — the repo is public
/costing-invoices/

# Clay-tab table specs (scripts/enrich-seed-table.mjs) — each holds one client's
# exclusion lists and AI prompts, so they live in the database, not the public repo
/enrich-specs/
